@keyframes kingAlert{
  0%,100%{ filter:drop-shadow(0 0 3px #ff3b2a) drop-shadow(0 0 6px #ff3b2a); }
  50%{ filter:drop-shadow(0 0 8px #ff1100) drop-shadow(0 0 18px #ff1100) brightness(1.15); }
}


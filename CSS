/* ===== 王手の演出 ===== */
.check-banner{
  position:fixed; left:0; right:0; top:50%;
  transform:translateY(-50%);
  z-index:45;
  display:none;
  justify-content:center;
  pointer-events:none;
}
.check-banner.show{ display:flex; animation:checkFlash 1.7s ease-out forwards; }
.check-banner::before{
  content:"";
  position:absolute; left:0; right:0; top:50%;
  height:150px; transform:translateY(-50%);
  background:linear-gradient(90deg, transparent 0%, rgba(150,10,10,.85) 18%, rgba(190,20,20,.92) 50%, rgba(150,10,10,.85) 82%, transparent 100%);
  box-shadow:0 0 40px rgba(255,60,40,.7);
}
.check-banner span{
  position:relative;
  font-family:var(--impact-font);
  font-size:min(26vw, 120px);
  line-height:1;
  letter-spacing:.06em;
  color:#fff3c4;
  -webkit-text-stroke:3px #5a0a06;
  paint-order:stroke fill;
  text-shadow:0 0 22px rgba(255,200,80,.9), 4px 6px 0 #5a0a06, 8px 12px 18px rgba(0,0,0,.6);
  transform:skewY(-3deg);
  animation:checkSlam .45s cubic-bezier(.2,1.6,.4,1) both;
}
@keyframes checkSlam{
  0%{ transform:scale(3.2) skewY(-3deg); opacity:0; }
  60%{ transform:scale(.92) skewY(-3deg); opacity:1; }
  100%{ transform:scale(1) skewY(-3deg); opacity:1; }
}
@keyframes checkFlash{
  0%{ opacity:0; }
  8%{ opacity:1; }
  75%{ opacity:1; }
  100%{ opacity:0; }
}
/* 王手をかけられている王を赤く点滅 */

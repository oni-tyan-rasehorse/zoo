/* ===== たたかう！ボタン（BOSS登場画面） ===== */
.btn-fight{
  position:relative; z-index:2; overflow:hidden;
  font-family:var(--impact-font);
  font-size:26px; letter-spacing:.08em; line-height:1.1;
  color:#fff8e0;
  padding:13px 42px 12px;
  border:3px solid #ffd97a;
  border-radius:14px;
  background:linear-gradient(180deg,#ff7a45 0%,#e8381e 52%,#a81a0e 100%);
  -webkit-text-stroke:1px #5a0e06;
  text-shadow:0 2px 0 #6a1008, 0 0 12px rgba(255,200,80,.8);
  box-shadow:
    0 6px 0 #6a1008,
    0 12px 24px rgba(0,0,0,.55),
    0 0 0 4px rgba(255,217,122,.25),
    inset 0 2px 0 rgba(255,255,255,.5),
    inset 0 -4px 8px rgba(90,10,4,.45);
  cursor:pointer;
  animation:fightPulse 1.1s ease-in-out infinite;
  transition:transform .08s ease, box-shadow .08s ease, filter .15s ease;
}
.btn-fight::before{
  content:"";
  position:absolute; top:0; left:-70%;
  width:45%; height:100%;
  background:linear-gradient(100deg, transparent, rgba(255,255,255,.65), transparent);
  transform:skewX(-20deg);
  animation:btnShine 2.2s ease-in-out infinite;
  pointer-events:none;
}
.btn-fight:hover{ filter:brightness(1.12); transform:translateY(-2px) scale(1.04); }
.btn-fight:active{
  animation:none;
  transform:translateY(5px);
  box-shadow:0 1px 0 #6a1008, 0 4px 10px rgba(0,0,0,.5), inset 0 2px 0 rgba(255,255,255,.4);
}
.btn-fight:focus-visible{ outline:3px solid #fff; outline-offset:4px; }
@keyframes fightPulse{
  0%,100%{ transform:scale(1); box-shadow:0 6px 0 #6a1008, 0 12px 24px rgba(0,0,0,.55), 0 0 0 4px rgba(255,217,122,.25), inset 0 2px 0 rgba(255,255,255,.5), inset 0 -4px 8px rgba(90,10,4,.45); }
  50%{ transform:scale(1.05); box-shadow:0 6px 0 #6a1008, 0 12px 24px rgba(0,0,0,.55), 0 0 0 8px rgba(255,217,122,.4), 0 0 28px rgba(255,160,60,.8), inset 0 2px 0 rgba(255,255,255,.5), inset 0 -4px 8px rgba(90,10,4,.45); }
}
@keyframes btnShine{
  0%,55%{ left:-70%; }
  100%{ left:130%; }
}

/* ===== もう一度あそぶボタン（勝敗画面） ===== */
.btn-again{
